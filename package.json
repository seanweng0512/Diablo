{
  "name": "diablo-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Discord Copilot Agent Bridge — control GitHub Copilot from Discord over the Agent Client Protocol",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "cli": "node dist/main.js --provider=cli",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "discord.js": "^14.27.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
